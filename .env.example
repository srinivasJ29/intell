# IntelliResearch System Environment Configuration

# Application
ENVIRONMENT=development
APP_NAME=IntelliResearch
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_bytes_min

# Security & JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database (PostgreSQL in production; SQLite async supported for local development)
DATABASE_URL=sqlite+aiosqlite:///./data/intelliresearch.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelliresearch

# Redis (Caching & Task Coordination)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=false

# Storage Subsystem (local or s3/minio)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=intelliresearch-documents
S3_REGION=us-east-1

# ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Embedding Model
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Configuration (OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, Groq, OpenRouter)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
